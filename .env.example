# Application Environment Variables Template
NODE_ENV="production"
PORT=3000
APP_NAME="FINANCE CONTROL PLATFORM"
APP_URL="https://finance.your-hospital.go.th"

# Timezone & Localization
TZ="Asia/Bangkok"
DEFAULT_FISCAL_YEAR=2569

# Database Configuration (MySQL 8 with utf8mb4)
DATABASE_URL="mysql://db_user:secure_password_here@localhost:3306/pdhfinance?charset=utf8mb4"

# Authentication & Session Security
# Generate with: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME_TO_A_VERY_LONG_RANDOM_SECRET_KEY"
SESSION_MAX_AGE=28800
COOKIE_SECURE=true

# Storage
UPLOAD_DIR="/var/www/pdhfinance/uploads"
MAX_FILE_SIZE_MB=10
